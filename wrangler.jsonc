{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "youtube-mp3-downloader",
  // Set this to today's date
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
}